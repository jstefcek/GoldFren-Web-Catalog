# Dockerfile (frontend)
FROM node:22.14.0-alpine
WORKDIR /goldfren_frontend

# 1. copy lock‑files first for better layer caching
COPY package*.json ./

# 2. **install *with* optional deps**
RUN npm ci      

# 3. copy the rest and build
COPY . .
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]